# Ollama API 配置
# 設定 Ollama 服務的 API URL
OLLAMA_API_URL=http://localhost:11434

# 設定 API Key（如果需要驗證）
OLLAMA_API_KEY=your_api_key_here

# Vite 開發服務器允許的主機列表（用逗號分隔）
# 注意: localhost 和 127.0.0.1 已經在 vite.config.js 中預設允許
# 只需要添加額外的域名，例如: VITE_ALLOWED_HOSTS=llmchat.example.com,your-domain.com
VITE_ALLOWED_HOSTS=

# 前端 URL（用於生成驗證鏈接和成功頁面鏈接）
# 生產環境請設定為您的前端域名，例如: https://llmchat.example.com
# 前端會通過代理將 /api/* 請求轉發到後端
# 開發環境預設為: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# SMTP 郵件設定（用於發送驗證郵件）
# 如果不設定 SMTP_USER 和 SMTP_PASS，用戶將無法註冊新帳號（登入畫面不會顯示註冊選項）
# Gmail SMTP 範例:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME=LLMChat

# 其他環境變數可以根據需要添加