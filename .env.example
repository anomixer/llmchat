# ===========================================
# LLM Provider 配置
# ===========================================
# 支援的 Provider 類型：
# - ollama (本地運行，免費)
# - openai (GPT-4, GPT-3.5)
# - anthropic (Claude 系列)
# - groq (極速推理)
# - deepseek (DeepSeek 系列)
# - nvidia (NVIDIA NIM)
# - mistral (Mistral 系列)
# - together (Together AI 平台)

# Provider 類型（預設：ollama）
LLM_PROVIDER=ollama

# Provider API 基礎 URL（預設根據 Provider 類型自動設定）
# 可自訂，例如：
# - Ollama: http://localhost:11434
# - OpenAI: https://api.openai.com
# - Groq: https://api.groq.com/openai
LLM_BASE_URL=http://localhost:11434

# API Key（如果 Provider 需要驗證）
LLM_API_KEY=your_api_key_here

# 預設模型名稱
LLM_MODEL=llama2

# 生成溫度（0-2，越高越有創造性）
LLM_TEMPERATURE=0.7

# 最大 Token 數
LLM_MAX_TOKENS=2048

# ===========================================
# 舊版 Ollama 設定（保留以兼容）
# ===========================================
OLLAMA_API_URL=http://localhost:11434
OLLAMA_API_KEY=your_api_key_here

# Vite 開發服務器允許的主機列表（用逗號分隔）
# 注意: localhost 和 127.0.0.1 已經在 vite.config.js 中預設允許
# 只需要添加額外的域名，例如: VITE_ALLOWED_HOSTS=llmchat.example.com,your-domain.com
VITE_ALLOWED_HOSTS=

# 前端 URL（用於生成驗證鏈接和成功頁面鏈接）
# 生產環境請設定為您的前端域名，例如: https://llmchat.example.com
# 前端永遠在 3000，後端 API 在 3001
FRONTEND_URL=http://localhost:3000

# SMTP 郵件設定（用於發送驗證郵件）
# 如果不設定 SMTP_USER 和 SMTP_PASS，用戶將無法註冊新帳號（登入畫面不會顯示註冊選項）
# Gmail SMTP 範例:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME=LLMChat

# ===========================================
# 系統與部署設定
# ===========================================
# 後端 API 伺服器埠口（預設：3001）
PORT=3001

# 是否由後端直接靜態託管編譯後的前端檔案（預設：false）
# Docker 容器內部署時建議設為 true，如此只需對外暴露單一服務埠口
SERVE_STATIC=false

# 開啟串流除錯日誌（預設：0，若需排查 SSE 問題可設為 1）
DEBUG_STREAM=0

